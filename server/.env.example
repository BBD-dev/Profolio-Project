# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URL=mongodb://localhost:27017/bbd-profolio
DB_NAME=bbd-profolio

# JWT (min 32 chars — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Public URLs
# Base URL where this API is reachable (used for local upload links). Leave empty to infer from request.
PUBLIC_API_URL=
# Where graduates log in — used in approval emails (e.g. https://app.example.com or http://207.154.248.90:8080)
PUBLIC_APP_URL=http://localhost:8081

# Cloudinary (file uploads: avatars, covers, project images, CVs). Optional — falls back to local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend) — approval / changes-requested / rejected notifications. Optional.
RESEND_API_KEY=
EMAIL_FROM="BBD Select <no-reply@yourdomain.com>"
EMAIL_REPLY_TO=

# Seed accounts (optional — created on first startup)
ADMIN_EMAIL=admin@bbdselect.com
ADMIN_PASSWORD=change-me-strong-password
DEMO_EMAIL=
DEMO_PASSWORD=

# Load rich demo dataset (graduates, requests, projects). Ignored in production unless RUN_SEED=true.
SEED_DEMO=false
RUN_SEED=false

# CORS (comma-separated origins). Required in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
